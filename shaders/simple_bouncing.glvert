//bounce.vert

uniform float time;		//value provided by application program
attribute vec4 vel;		//value provided by application program

void main(void)
{
  
    float s = 1000.0;		//scale factor
    float g = 9.8;		//gravitational acceleration	
    float h, h0;			//h0 = initial height
    float t0;
    float c = 0.9;		//coefficient of restitution

    h0 = 12; // Initial height
    vec3 norm = vec3 ( 0, 1, 0 );
    vec3 vel1, vel2;
  
    t0 = sqrt ( 2 * h0 / g );	//time to reach ground
  
    vel1.x = vel.x;
    vel1.y = vel.y - g * t0;
    vel1.z = vel.z;

    //initial height is gl_vertex.y  
    h = h0 - g/(2.0)*time*time;	//height of ball at current time

    while ( h <= 0 )
    {	
        //ball should always be above ground
        vel2 = c * reflect ( vel1, norm );  	//bouncing velocity reduced
        time = time - t0;
        h = vel2.y * time - g/(2.0) * time * time;
        h0 = c * h0;				//reduced bouncing height
        t0 = 2 * sqrt ( 2 * h0 / g );		//time for one bounce
        vel1.y = vel2.y - g * t0;
    }
  
   
   vec4 v = vec4( gl_Vertex.x, h + gl_Vertex.y, gl_Vertex.z,1); 
  
   gl_Position = gl_ModelViewProjectionMatrix * v;	//object_pos;
}
